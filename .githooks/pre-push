#!/bin/sh
# Blocks a push unless the hub rules, the tests and the evals for what changed all pass.
# Turn on once per clone: npm run hooks. Skip once (for example a typo in the README): git push --no-verify
set -e
cd "$(git rev-parse --show-toplevel)"
node scripts/hub.js check
npm test --silent >/dev/null || { echo "pre-push: npm test failed; run it to see why"; exit 1; }
git fetch --quiet origin main 2>/dev/null || true
node scripts/evals.js --base origin/main
